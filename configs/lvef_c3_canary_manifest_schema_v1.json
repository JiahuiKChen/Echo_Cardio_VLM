{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo-ai.invalid/schemas/lvef_c3_canary_manifest_schema_v1.json",
  "title": "Owner-private exact-five LVEF C3 canary manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "manifest",
    "manifest_sha256"
  ],
  "properties": {
    "schema_name": {
      "const": "lvef_c3_exact_five_canary_manifest"
    },
    "schema_version": {
      "const": 1
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_method_version",
        "source_release",
        "source_authority_commit",
        "source_manifest_sha256",
        "source_configuration_hashes",
        "study_count",
        "subject_count",
        "split",
        "complete_object_membership",
        "expected_object_count",
        "expected_byte_total",
        "studies"
      ],
      "properties": {
        "selection_method_version": {
          "const": "source_object_count_quintile_representatives_numeric_id_tiebreak_v1"
        },
        "source_release": {
          "const": "mimic-iv-echo/1.0"
        },
        "source_authority_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_configuration_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_name", "sha256"],
            "properties": {
              "logical_name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "study_count": {
          "const": 5
        },
        "subject_count": {
          "const": 5
        },
        "split": {
          "const": "train"
        },
        "complete_object_membership": {
          "const": true
        },
        "expected_object_count": {
          "type": "integer",
          "minimum": 5,
          "maximum": 750
        },
        "expected_byte_total": {
          "type": "integer",
          "minimum": 5,
          "maximum": 5000000000
        },
        "studies": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/lowStudy"},
            {"$ref": "#/$defs/lowerMiddleStudy"},
            {"$ref": "#/$defs/medianStudy"},
            {"$ref": "#/$defs/upperMiddleStudy"},
            {"$ref": "#/$defs/highStudy"}
          ],
          "items": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "sourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_object_key",
        "source_relative_path",
        "size_bytes",
        "generation",
        "md5_base64",
        "crc32c_base64"
      ],
      "properties": {
        "source_object_key": {
          "$ref": "#/$defs/sha256"
        },
        "source_relative_path": {
          "type": "string",
          "pattern": "^files/p[0-9]{2}/p[0-9]+/s[0-9]+/[A-Za-z0-9._-]+[.]dcm$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "md5_base64": {
          "$ref": "#/$defs/base64"
        },
        "crc32c_base64": {
          "$ref": "#/$defs/base64"
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "subject_id",
        "split",
        "selection_stratum",
        "known_no_cine",
        "prior_reconstruction_smoke",
        "complete_object_membership",
        "expected_object_count",
        "expected_byte_total",
        "objects"
      ],
      "properties": {
        "study_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "split": {
          "const": "train"
        },
        "selection_stratum": {
          "type": "string"
        },
        "known_no_cine": {
          "const": false
        },
        "prior_reconstruction_smoke": {
          "const": false
        },
        "complete_object_membership": {
          "const": true
        },
        "expected_object_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 750
        },
        "expected_byte_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000000
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 750,
          "items": {
            "$ref": "#/$defs/sourceObject"
          }
        }
      }
    },
    "lowStudy": {
      "allOf": [
        {"$ref": "#/$defs/study"},
        {"properties": {"selection_stratum": {"const": "relatively_low_object_count"}}}
      ]
    },
    "lowerMiddleStudy": {
      "allOf": [
        {"$ref": "#/$defs/study"},
        {"properties": {"selection_stratum": {"const": "lower_middle_object_count"}}}
      ]
    },
    "medianStudy": {
      "allOf": [
        {"$ref": "#/$defs/study"},
        {"properties": {"selection_stratum": {"const": "near_median_object_count"}}}
      ]
    },
    "upperMiddleStudy": {
      "allOf": [
        {"$ref": "#/$defs/study"},
        {"properties": {"selection_stratum": {"const": "upper_middle_object_count"}}}
      ]
    },
    "highStudy": {
      "allOf": [
        {"$ref": "#/$defs/study"},
        {"properties": {"selection_stratum": {"const": "relatively_high_object_count"}}}
      ]
    }
  }
}
